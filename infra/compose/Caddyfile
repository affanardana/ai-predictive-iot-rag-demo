# TLS termination for the two things that need to be reachable from outside.
#
# The API and n8n are otherwise unexposed: neither publishes a port, so this is
# the only way in. The inference service is internal to the Compose network and
# has no route here at all -- nothing outside needs to score a window.

{
	# The admin API can reload configuration at runtime and is not needed here,
	# because the stack is reconfigured by restarting the container. Turning it
	# off removes an unauthenticated control surface.
	admin off
}

# The API.
#
# Reads are deliberately unguarded -- the Phase 7 dashboard and the copilot read
# this from a browser, and requiring a secret there would mean shipping one to
# every client. The three routes that *write* require the `X-Ingest-Token`
# header, enforced in the application rather than here, so that the rule lives
# beside the domain it protects rather than in a proxy config.
{$API_HOST} {
	reverse_proxy api:8000
}

# n8n's editor.
#
# It has its own account system, which is the only thing standing between the
# internet and a workflow that can write to the database. Create the owner
# account immediately after first boot.
#
# `reverse_proxy` handles the `Upgrade` header without configuration, which
# matters more than it sounds: n8n's editor opens a persistent websocket at
# `/rest/push` for live updates, and a proxy that drops it leaves the workflows
# page spinning forever with nothing in n8n's logs to explain why.
{$PDM_HOST} {
	reverse_proxy n8n:5678
}
