# Environment for the Compose stack in this directory.
#
#     cp env.template .env
#
# Named `.template` rather than `.env.example` on purpose. The repository
# already has a `.env.example` and it is gitignored -- `.gitignore` excludes
# `.env` and `.env.*` -- which makes it a fine laptop convention and a useless
# server one, because `git clone` on the VPS cannot bring it along. This file
# is committed so the server gets it the same way it gets the code.
#
# `.env` itself is still ignored, and it must never be committed.

# ---------------------------------------------------------------------------
# Where this host is reachable
# ---------------------------------------------------------------------------
# Not read by `compose.yaml` -- it is here so the two hostnames are written down
# beside everything else, and it is what `caddy.snippet` and `README.md` refer
# to.
#
# `sslip.io` resolves any hostname containing an IP address to that IP, so these
# need no DNS record and no domain purchase: the literal IP with dots replaced
# by dashes, plus the domain.
#
# The public names are served by the Caddy that already runs on this host, not
# by one of ours -- it owns ports 80 and 443, and a second proxy cannot share
# them. See `caddy.snippet` for the two blocks to add and the commands to
# validate and reload them.
PDM_HOST=72-61-214-194.sslip.io

# The full public URLs, for reference:
#
#   dashboard    https://pdm-sim.vercel.app          (Vercel, not this host)
#   n8n editor   https://pdm.72-61-214-194.sslip.io
#   API          https://pdm-api.72-61-214-194.sslip.io
#
# The last two forward to this host's loopback -- 8101 and 8100 respectively,
# which is how the shared Caddy reaches every service on this box. The dashboard
# is a static build on Vercel that reads the API from a browser, so it is the
# only public surface here that does not pass through Caddy.

# ---------------------------------------------------------------------------
# Database -- Supabase, unchanged
# ---------------------------------------------------------------------------
# Required. The API exits at startup without it.
#
# Two things bite here, and both produce confusing failures rather than clear
# ones:
#
#   * The scheme must be `postgresql+psycopg://`. A bare `postgresql://`
#     resolves to psycopg2, which this project does not install, and the error
#     names a missing module rather than the URL that caused it. Supabase hands
#     out URLs without a driver, so the `+psycopg` has to be added by hand. The
#     API rejects the bare scheme at startup with a message saying so.
#
#   * Use the SESSION pooler on port 5432, never the transaction pooler on 6543.
#     The transaction pooler drops server-side prepared statements, which
#     SQLAlchemy relies on, and queries fail intermittently. The API rejects
#     6543 at startup for the same reason.
#
# `?sslmode=require` is what Supabase expects and is correct here; it is only a
# problem against a Postgres with TLS off, which this stack does not run.
DATABASE_URL=

# ---------------------------------------------------------------------------
# The write credential
# ---------------------------------------------------------------------------
# Required. One secret, three readers:
#
#   * the API, as `INGEST_API_TOKEN`, guarding POST /api/v1/telemetry,
#     POST /api/v1/machines and POST /api/v1/machines/{id}/predictions;
#   * n8n, as `PDM_INGEST_TOKEN`, which the workflow sends as `X-Ingest-Token`.
#
# They are set from this single variable in `compose.yaml`, so they cannot drift
# apart -- which is worth doing because a mismatch is a 401 on every write and
# looks like a broken workflow rather than a configuration error.
#
# Two constraints the API enforces at startup, both learned the hard way:
#
#   * Not blank. `compare_digest("", "")` is true, so an empty token would
#     authenticate a request carrying no header at all.
#   * ASCII only. An HTTP header value is a byte string, so a token outside
#     ASCII could never be presented by any client and would refuse every
#     caller forever.
#
# Generate one with:
#
#     openssl rand -hex 32
INGEST_API_TOKEN=

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
# Required, and set from first boot so that it lives here rather than only
# inside the `n8n-data` volume.
#
# **Never change this once n8n has started.** n8n encrypts its stored
# credentials with it, and a value that disagrees with the one already written
# does not degrade -- n8n refuses to boot:
#
#     Error: Mismatching encryption keys. The encryption key in the settings
#     file /data/.n8n/config does not match the N8N_ENCRYPTION_KEY env var.
#
# That is not hypothetical; it broke this project's first deployment. The
# difference here is that it is set before first boot rather than after, which
# is the only safe order.
#
# Generate with:
#
#     openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Read by all three Python services, not just the API, so one value covers the
# containers and their logs can be filtered together. `docker compose logs`
# prints JSON lines; `grep '"level": "ERROR"'` is a query.
LOG_LEVEL=INFO

# Bearer token for `GET /metrics`, if you want the endpoint private.
#
# Leave it blank and the endpoint is public, which is a defensible default
# rather than an oversight: the exposition carries route templates, status
# codes and timings -- no machine ids, no addresses, no question text.
#
# Set it to guard the endpoint, and give the scraper the same value as an
# `Authorization: Bearer <token>` header. **Check that your scraper can send
# headers first**: a collector that accepts only a URL can never satisfy this,
# and the failure surfaces as "target down" with nothing in the container's
# logs to explain it.
#
#     openssl rand -hex 32
METRICS_TOKEN=

# Which addresses' `X-Forwarded-For` is believed, when working out who a request
# is charged to for rate limiting.
#
# This is the single most fragile value in this file, because getting it wrong
# has no symptom until a budget is exhausted. Two things have to agree and both
# read this one variable:
#
#   * uvicorn's `ProxyHeadersMiddleware` (through `FORWARDED_ALLOW_IPS`);
#   * the API's own resolution, which charges a request to the rightmost
#     forwarded address that is not itself a proxy.
#
# The API publishes only to loopback, but Docker forwards through the bridge, so
# the peer the container sees is the gateway -- `172.17.0.1` and friends, inside
# `172.16.0.0/12`. uvicorn's own default trusts `127.0.0.1,::1` only, which the
# gateway is not: left at that default, no forwarding header is ever believed
# and **every visitor on earth shares one rate-limit budget**.
#
# Check it after deploying. `docker network inspect pdm_default --format
# '{{range .IPAM.Config}}{{.Subnet}}{{end}}'` prints the subnet; if your host
# overrides `default-address-pools` in `/etc/docker/daemon.json`, that is the
# value to put here instead.
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# ---------------------------------------------------------------------------
# Rate limits, in requests per minute, per source address
# ---------------------------------------------------------------------------
# These take the guard's place on the routes that spend real resources. Phase 11
# keeps the reads open -- a login a reviewer cannot pass would delete the
# demonstration -- so the expensive routes are bounded instead.
#
#   * the global ceiling covers every route including ones added later, and
#     charges only callers from outside the Compose network. The pipeline is
#     exempt on purpose: n8n writes about one telemetry batch a second per
#     running machine, and metering that would drop readings rather than slow a
#     dashboard.
#   * the three route ceilings are per caller, and are what stop one visitor
#     monopolising the Copilot's single answer slot.
#
# Sizing rule: a single dashboard tab polls roughly ten times a minute idle, and
# about fifty with a live run. Two tabs plus a run is the worst honest case at
# around two hundred, which is why the global ceiling is where it is. **A limit
# that fires during the canonical demonstration has cost more than it saved.**
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_COPILOT_PER_MINUTE=1
RATE_LIMIT_SIMULATION_PER_MINUTE=1
RATE_LIMIT_SEARCH_PER_MINUTE=6

# PRD section 9. Product configuration for this synthetic demonstration, not
# universal industrial thresholds, and applied by the product rather than by the
# model -- the LSTM emits a probability and nothing else.
RISK_WARNING_THRESHOLD=0.30
RISK_HIGH_THRESHOLD=0.60
RISK_CRITICAL_THRESHOLD=0.80

# Where `best.pt` and `artifact/normalization.json` are on the host, relative to
# this directory. Both are gitignored, so they are copied to the server by hand
# -- see README.md. The inference container will not start without them. The
# Copilot's GGUF lives here too, under `chat/`.
MODEL_DIR=./model

# The embedding model the stored vectors were produced by, name and revision.
# Retrieval only compares vectors carrying this string and the API refuses to
# store any that came from another one: vectors from two models are not
# comparable, and mixing them ranks plausibly and means nothing.
#
# It must match what the inference service loaded. Pin both to the commit the
# image actually fetched once it is known.
KNOWLEDGE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2@main

# The lowest rerank score that counts as evidence, below which the answer is
# "the documentation does not cover this" (PRD section 19) and the Copilot
# refuses rather than answering from the nearest neighbour.
#
# **This value is measured, not chosen.** The reranker is a cross-encoder whose
# logits centre near zero -- negative about half the time -- so the obvious
# default of 0 stands in the middle of its range rather than beneath it. It
# admitted a near-miss question and abstained on one of the twelve answerable
# ones. Scoring the evaluation's seventeen questions against the deployed corpus:
#
#     answerable questions    median +4.26    worst  -2.48
#     unanswerable questions  median -8.17    best   -4.20
#
# The two sets separate in the gap between -4.20 and -2.48; -3.3 is its
# midpoint, with about 0.8 of margin on each side. Re-derive it after any change
# to the corpus, the embedding model or the reranker:
#
#     docker compose --profile tools run --rm ingest \
#       python -m ml knowledge evaluate --api-url http://api:8000
#
# The `separation` row is the difference between the two medians (12.43 here),
# and the per-question `sufficient` column is where the outliers are.
KNOWLEDGE_MINIMUM_SCORE=-3.3

# How many simulated runs may be active at once, across the fleet.
#
# One run per machine is enforced separately and structurally, by a unique index
# in the schema. This is the ceiling on top of it, and it exists because a run
# costs CPU on a box that shares one core between the simulator, n8n, the API
# and torch -- and because the endpoint that starts runs is unguarded, so anyone
# who finds the hostname can ask for one.
#
# Three is a guess rather than a measurement. Raise it only after watching
# `docker stats` during a real run.
SIMULATION_MAX_CONCURRENT_RUNS=3

# Wall-clock seconds between a run's readings. One second replays four hours of
# degradation in four minutes.
#
# Not exposed on the dashboard form, deliberately: PRD section 11 does not list
# a pacing control, and a caller setting a fast pace on one core is the failure
# the limits above exist to bound.
SIMULATOR_TICK_SECONDS=1.0

# ---------------------------------------------------------------------------
# The Copilot's language model
# ---------------------------------------------------------------------------
# A file *name*, not a path. `compose.yaml` derives both sides of it from this
# one value -- the path the inference container loads (`/model/chat/<name>`) and
# the name the API reports as the model that wrote an answer (`COPILOT_MODEL`) --
# so the two cannot disagree. A swap that updated only one of them would label
# every answer with a model that did not write it.
CHAT_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf

# The weights are placed by hand beside `best.pt`, for the same reasons: they
# are gitignored, they are the one thing here that is measured in hundreds of
# megabytes, and changing the model should not mean rebuilding an image on a
# one-core host.
#
#     <MODEL_DIR>/chat/qwen2.5-1.5b-instruct-q4_k_m.gguf
#
# 940 MB, from Hugging Face:
#
#     https://huggingface.co/bartowski/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
#
# Measured on this host, so the numbers behind the memory limit are not
# estimates: 20.6 s to load, 7.8 tokens/second to decode, 1724 MiB peak RSS.

# The context window, and so the KV cache that stays resident between questions.
# 2048 rather than the model's own 32768: the prompt sent here is a few hundred
# tokens, and this is the memory the box would otherwise not get back.
INFERENCE_CHAT_CONTEXT=2048

# How many questions the Copilot may answer at once. One, because a generation
# burns the single core for about twenty seconds -- a second question would
# halve the speed of the first and leave both readers waiting twice as long.
# The endpoint is unguarded, so this is the bound that takes a token's place.
COPILOT_MAX_CONCURRENT_QUESTIONS=1
