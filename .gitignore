# All the document regarding specification set (spec-driven development) must be local-only, never published
spec_driven_development/

# The maintenance corpus (Phase 9). Committed deliberately, and it was ignored
# until Phase 9 -- at which point the PDFs stopped being scratch material and
# became a fixture: the extraction tests parse them, the ingest pipeline reads
# them, and the retrieval evaluation is scored against their content. A clone
# without them cannot run the corpus tests, ingest anything, or reproduce the
# evaluation numbers.
#
# Ten PDFs, 624 KB. They were printed from a browser (`/Creator: Chromium`) and
# nothing in this repository generates them, so they are the only copy.
#
# See `knowledge/corpus.json` for the manifest that maps each file to its
# document key, category and version.

# The detailed working README. `README.md` is the short version shown on the
# repository page; this one is the full reference for whoever is working in the
# repository, and is not published.
README.full.md

# --- Secrets ---------------------------------------------------------------
# Never commit real credentials. `.env.example` is the committed template.
.env
.env.*
.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
*.egg-info/
.eggs/
dist/
build/

# --- Tooling caches --------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Local scratch (SQLite files, dumps, ad-hoc exports) -------------------
.local/
*.db
*.sqlite
*.sqlite3

# --- ML artefacts (Phase 3+) ----------------------------------------------
mlruns/
mlartifacts/
data/
!data/.gitkeep

# Model checkpoints. `data/models/` would cover the default output location
# already, via `data/` above, but a checkpoint is the kind of file that gets
# copied somewhere convenient and committed by reflex. The run manifest beside
# it is what should travel: it carries the config, seeds, git SHA and dataset
# fingerprint, so a checkpoint is regenerable rather than precious.
*.pt
*.ckpt
*.pth
ml/notebooks/.ipynb_checkpoints/

# The Colab run's outputs: the downloaded checkpoint and the raw reports.
#
# The leading slash matters. A bare `colab_report/` would match at any depth,
# and a bare `model/` matches any directory of that name -- including
# `ml/src/ml/model/`, the torch source package -- silently, and only in a
# commit, which is the hardest place to notice it.
#
# The results that matter are written up in `ml/README.md` and the CHANGELOG, so
# these are working copies rather than the record.
/colab_report/

# --- Frontend (Phase 7+) ---------------------------------------------------
node_modules/
.vite/
*.tsbuildinfo

# The OpenAPI document the frontend's types are generated from, exported from
# the API by `apps/api/scripts/export_openapi.py`.
#
# Derived, so it is not committed -- but the **generated** `schema.d.ts` is,
# because it is what the frontend compiles against. That combination is what
# makes drift visible: CI re-exports the document, regenerates the types, and
# fails if the checked-in file differs.
/apps/web/openapi.json
/apps/web/dist/
/apps/web/.env.local
/apps/web/.env.*.local

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
