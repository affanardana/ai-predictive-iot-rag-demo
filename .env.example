# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#
#   Copy-Item .env.example .env        # PowerShell
#
# `.env` is gitignored and must never be committed. The application reads it
# through `infrastructure/config.py`.
# ---------------------------------------------------------------------------

# Runtime environment: local | ci | production
APP_ENV=local

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Operational database (Supabase Postgres) ------------------------------
#
# Use the **session pooler on port 5432**, which is the mode that supports the
# server-side prepared statements SQLAlchemy depends on:
#
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Do NOT use the transaction pooler on port 6543 — Supabase documents that
# ORMs relying on prepared statements break there. The direct-connection host
# (db.<ref>.supabase.co) resolves to IPv6 by default and may be unreachable on
# IPv4-only networks.
#
# Percent-encode any reserved characters in the password (@ : / ? # [ ]).
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Test database (optional) ----------------------------------------------
#
# Used only by tests marked `postgres`. When this is unset those tests are
# skipped automatically and the whole suite runs on in-memory SQLite, so the
# default `uv run pytest` needs no credentials and no network.
#
# TEST_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Risk band thresholds (PRD section 9) ----------------------------------
#
# Product configuration for the synthetic demonstration. These are NOT
# universal industrial standards, and the product must say so in its UI.
#
#   0.00 - 0.29  NORMAL
#   0.30 - 0.59  WARNING
#   0.60 - 0.79  HIGH
#   0.80 - 1.00  CRITICAL
#
# Must satisfy: warning < high < critical, all within 0.0-1.0.
RISK_WARNING_THRESHOLD=0.30
RISK_HIGH_THRESHOLD=0.60
RISK_CRITICAL_THRESHOLD=0.80
